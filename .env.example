# ---------------------------------------------------------------------------
# TaskPilot configuration. Copy to `.env` and fill in values.
# NEVER commit `.env`. It is git-ignored.
# ---------------------------------------------------------------------------

# --- LLM provider (required) ------------------------------------------------
# Supported values: openrouter | openai | anthropic | mock
# `mock` is a scripted model simulator for offline tests only. It is NOT a
# production fallback and is never activated implicitly.
LLM_PROVIDER=openrouter

# Provider API key. Never hard-coded in source, never committed.
LLM_API_KEY=

# Base URL of the chat-completions endpoint.
# openrouter -> https://openrouter.ai/api/v1
# openai     -> https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model identifier as understood by the provider.
# openrouter free tier (verified to support native tool calling):
#   qwen/qwen3.8-27b:free
# openrouter paid examples: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
LLM_MODEL=qwen/qwen3.8-27b:free

LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=1024

# Safety valve only. When true and no LLM_API_KEY is configured, the runtime
# starts but every task fails fast with LLM_UNAVAILABLE. It never silently
# produces "autonomous" results from a deterministic planner.
DETERMINISTIC_FALLBACK=false

# --- Company sandbox (local, deterministic demo data) -----------------------
SANDBOX_URL=http://127.0.0.1:3001
SANDBOX_USERNAME=demo
SANDBOX_PASSWORD=demo123

# --- Storage ---------------------------------------------------------------
DATABASE_PATH=./data/taskpilot.db
LOG_LEVEL=INFO

# empty | finance_session_expired | verification_mismatch | network_error
# Affects sandbox behaviour only; it never bypasses the LLM.
FAILURE_MODE=

# Default demo mode for new tasks:
# normal | recoverable_failure | verification_failure | approval_required
DEMO_MODE=normal

# --- Deterministic safety policy (server-side, not model controlled) -------
# sensitive = every sensitive tool requires human approval (default)
# demo      = approval only in the approval_required demo mode
APPROVAL_POLICY=sensitive

# Hard ceilings. The model cannot raise these.
MAX_RETRIES=2
MAX_STEPS=24
TOOL_TIMEOUT_SECONDS=20
MAX_CONTEXT_MESSAGES=40

# --- Browser tools (real Playwright, sandbox-restricted) -------------------
USE_BROWSER=false
# empty = Playwright bundled Chromium | chrome | msedge = installed browser
BROWSER_CHANNEL=

# --- Service binding -------------------------------------------------------
WEB_ORIGIN=http://127.0.0.1:3000
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=3001
